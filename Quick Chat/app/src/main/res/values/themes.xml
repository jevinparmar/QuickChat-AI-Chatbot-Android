<resources>

    <style name="Base.Theme.QuickChatAiChatBot" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/qc_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/qc_soft_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">@color/qc_accent_blue</item>
        <item name="colorPrimaryContainer">@color/qc_surface_blue_soft</item>
        <item name="colorOnPrimary">@color/qc_soft_black</item>
        <item name="colorSecondary">@color/qc_soft_white</item>
        <item name="android:colorAccent">@color/qc_accent_blue</item>
        <item name="android:textColorPrimary">@color/qc_primary_text</item>
        <item name="android:textColorSecondary">@color/qc_secondary_text</item>
        <item name="android:windowAnimationStyle">@style/QuickChatDialogAnimation</item>
    </style>

    <style name="Theme.QuickChatAiChatBot" parent="Base.Theme.QuickChatAiChatBot" />

    <style name="Theme.QuickChatAiChatBot.ChatHistoryPanel" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/SlideLeftPanelAnimation</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="SlideLeftPanelAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_left</item>
    </style>

    <style name="QuickChatDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/fade_scale_in</item>
        <item name="android:windowExitAnimation">@anim/fade_scale_out</item>
    </style>

</resources>