<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="56dp"
        android:background="@drawable/bg_user_attachment_message"
        android:elevation="2dp"
        android:maxWidth="288dp"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_file_preview_inner"
            android:contentDescription="@string/selected_image_preview"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/fileIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/selected_file_icon"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/qc_soft_black" />

        <TextView
            android:id="@+id/textViewFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxWidth="220dp"
            android:text="@string/sample_file_name"
            android:textColor="@color/qc_soft_black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewFileType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:maxWidth="220dp"
            android:text="@string/sample_file_type"
            android:textColor="#0B3B29"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textViewOptionalCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:maxWidth="220dp"
            android:text="@string/sample_caption"
            android:textColor="@color/qc_soft_black"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
