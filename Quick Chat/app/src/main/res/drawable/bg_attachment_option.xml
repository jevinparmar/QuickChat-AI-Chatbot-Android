<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#183126" />
            <stroke android:width="1dp" android:color="@color/qc_accent_blue" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#121C19" />
            <stroke android:width="1dp" android:color="@color/qc_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
